<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Il primo tema esplicito dell'app: prima si prendeva quello di sistema.
        NoActionBar perche' la schermata disegna gia' il proprio titolo, e la
        barra di sistema sarebbe un secondo «HealthBridge» sopra il primo.

        La base scura fa in modo che anche cio' che non disegniamo noi — il
        selettore dell'ora della fascia di silenzio — resti in tinta con il
        resto, e il windowBackground toglie il lampo bianco fra lo splash e il
        primo fotogramma.
    -->
    <style name="Theme.HealthBridge" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
</resources>
